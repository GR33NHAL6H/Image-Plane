set cut_paste_input [stack 0]
version 15.0 v5
push $cut_paste_input
Group {
name ImagePlane
knobChanged "n = nuke.thisNode()\nk = nuke.thisKnob()\n\nif k.name() in \"geoChoice\":\n    v = n\['geoChoice'].getValue()\n    \n    # 0.0=Card, 1.0=Sphere, 2.0=Input Geo, 3.0=Ground Card\n    \n    n\['cardDistance'].setVisible(v == 0.0 or v == 1.0)\n    \n    n\['xrotate'].setVisible(v == 0.0)\n    n\['yrotate'].setVisible(v == 0.0)\n    \n    # rotateX and translateY: Visible only for Ground Card\n    n\['rotateX'].setVisible(v == 3.0)\n    n\['translateY'].setVisible(v == 3.0)\n    \n    n\['cardOverscan'].setVisible(v == 0.0)"
tile_color 0x2b576bff
gl_color 0x9b835eff
label "\n\[value geoChoice]\nx\[value refFrame]\n\[value transformType]\n\[value holdOrPlay]\nMoBlur: \[value scanlineSamples]\n-"
note_font "Bitstream Vera Sans Bold Italic"
note_font_color 0xe9b763ff
selected true
xpos 1829
ypos 590
postage_stamp_frame 1001
addUserKnob {20 User l -}
addUserKnob {26 txt l "" +STARTLINE T "<b><font size=\"40\"><font color=\"#BAA655\">IMAGE</font> <font size=\"40\"><font color=\"#558A95\"> PLANE</font></b>"}
addUserKnob {26 ""}
addUserKnob {26 ImagePlane l "<b><font color=\"#BAA655\">Input Attributes</font></b>"}
addUserKnob {4 projectionMethod l "Projection Method" M {"New (beta)" Old}}
addUserKnob {41 format l Format T Constant1.format}
addUserKnob {4 geoChoice l Geo t "You can choose the geo type you would like to project onto. The card, sphere and ground card will all be created around the camera that has been attached to the input. Use the geo input to add your own geo setup to project onto" M {Card Sphere "Input Geo" "Ground Card" "" ""}}
addUserKnob {3 refFrame l Ref}
refFrame 1001
addUserKnob {22 setFrame l "Set to current frame" -STARTLINE T "v = nuke.frame()\nt = nuke.thisNode()\['refFrame']\nt.setValue(v)"}
addUserKnob {4 holdOrPlay l Input M {Framehold Play "" "" "" "" ""}}
addUserKnob {4 transformType l Type M {Matchmove Stabalise ""}}
addUserKnob {26 _1 l "<b><font color=\"#BAA655\">Geo Attributes</font></b>"}
addUserKnob {7 cardDistance l Distance R 0 300}
cardDistance 100
addUserKnob {7 xrotate l "Rotate X" R -1 1}
addUserKnob {7 yrotate l "Rotate Y" R -1 1}
addUserKnob {3 rotateX l "Rotate Ground" +HIDDEN}
rotateX -90
addUserKnob {3 translateY l "Translate Ground" +HIDDEN}
addUserKnob {26 ProjectionFixes l "<b><font color=\"#BAA655\">Projection Fixes</font></b>"}
addUserKnob {41 occlusion_mode l "Occlusion Mode" T Project3D1.occlusion_mode}
addUserKnob {7 cardOverscan l "Card Overscan" R 10 50}
cardOverscan 10
addUserKnob {7 overscan l "Scanline Overscan" R 100 500}
overscan 100
addUserKnob {7 reformatScale l "Reformat Canvas" R 1 2}
reformatScale 1
addUserKnob {7 scanlineSamples l "Scanline Samples" R 1 10}
scanlineSamples 1
addUserKnob {26 ""}
addUserKnob {26 txt2 l "" -STARTLINE T "<div style=\"text-align: left; font-size: 10px; color: #666666; font-style: italic;\">\n  v 1.6 : updated 2026-08 : thomas.greenhalgh@framestore.com\n</div>\n\n"}
addUserKnob {1 FS_PROPERTY +HIDDEN}
}
Input {
inputs 0
name Inputcam
xpos 2100
ypos -765
addUserKnob {20 User}
addUserKnob {3 FocalLength}
FocalLength {{"\[value \[topnode input0].focal]"}}
addUserKnob {3 Haperture}
Haperture {{"\[value \[topnode input0].haperture]"}}
addUserKnob {3 Vaperture}
Vaperture {{"\[value \[topnode input0].vaperture]"}}
addUserKnob {30 WindowTranslate}
WindowTranslate {{"\[value \[topnode input0].win_translate.u]"} {"\[value \[topnode input0].win_translate.v]"}}
addUserKnob {30 WindowScale}
WindowScale {{"\[value \[topnode input0].win_scale.u]"} {"\[value \[topnode input0].win_scale.v]"}}
addUserKnob {13 Translate}
Translate {{"\[value \[topnode input0].translate.x]"} {"\[value \[topnode input0].translate.y]"} {"\[value \[topnode input0].translate.z]"}}
addUserKnob {13 Rotate}
Rotate {{"\[value \[topnode input0].rotate.x]"} {"\[value \[topnode input0].rotate.y]"} {"\[value \[topnode input0].rotate.z]"}}
addUserKnob {13 Scale}
Scale {{"\[value \[topnode input0].scaling.x]"} {"\[value \[topnode input0].scaling.y]"} {"\[value \[topnode input0].scaling.z]"}}
}
